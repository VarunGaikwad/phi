{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["guard-host/**/*.ts", "extensions/**/*.ts", "tests/**/*.ts"]
}
